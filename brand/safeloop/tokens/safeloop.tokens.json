      "shadow": {
        "sm": {
          "$type": "shadow",
          "$value": "0 1px 2px rgba(0, 0, 0, 0.40)"
        },
        "md": {
          "$type": "shadow",
          "$value": "0 2px 8px rgba(0, 0, 0, 0.45)"
        },
        "lg": {
          "$type": "shadow",
          "$value": "0 12px 32px rgba(0, 0, 0, 0.55)"
        },
        "focus": {
          "$type": "shadow",
          "$value": "0 0 0 2px #0F1B2D, 0 0 0 4px #1FC7B4"
        }
      }
    }
  }
}
